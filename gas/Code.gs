const SHEETS={catin:['id','tanggalInput','kua','kapanewon','namaCatin1','namaCatin2','tanggalAkad','jenisKontribusi','jumlahRencana','satuan','kontakReferensi','petugas','keterangan','createdAt'],penerimaan:['id','catinId','tanggalTerima','kua','kapanewon','namaCatin1','namaCatin2','jenisKontribusi','jenisSpesies','jumlahDiterima','satuan','sumber','kondisiAwal','statusVerifikasi','catatan','createdAt'],realisasi:['id','penerimaanId','catinId','tanggalRealisasi','kua','kapanewon','namaCatin1','namaCatin2','jenisKontribusi','jenisSpesies','jumlahDiterima','realisasiSebelumnya','jumlahRealisasi','saldo','satuan','metodeRealisasi','lokasi','desaKelurahan','jenisPerairan','pelaksana','statusVerifikasi','catatan','createdAt'],monitoring:['id','realisasiId','penerimaanId','catinId','tanggalMonitoring','kua','kapanewon','namaCatin1','namaCatin2','jenisKontribusi','jenisSpesies','lokasi','jumlahRealisasi','jumlahHidup','jumlahMati','persen','petugas','hasilTemuan','tindakLanjut','status','createdAt'],users:['username','name','role','kua','salt','passwordHash','active','createdAt']};
const SP=PropertiesService.getScriptProperties();
function doGet(){return out({ok:true,service:'SIP-CAPING API',version:'1.0'});}
function doPost(e){try{const p=JSON.parse(e.postData.contents||'{}');if(p.serverToken!==SP.getProperty('SERVER_TOKEN'))throw new Error('Akses server tidak sah');const a=p.action;let result;
if(a==='login')result=login(p);
else {const user=verifySession(p.session);if(a==='me')result={user:publicUser(user)};else if(a==='getAll')result={data:getAll(user)};else if(a==='save')result=saveRecord(user,p.table,p.data);else if(a==='delete')result=deleteRecord(user,p.table,p.id);else if(a==='saveUser')result=saveUser(user,p.data);else throw new Error('Aksi tidak dikenal');}
return out({ok:true,...result});}catch(err){return out({ok:false,error:err.message||String(err)});}}
function out(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);}
function setupSIPCAPING(){const id=SP.getProperty('SPREADSHEET_ID');if(!id)throw new Error('Isi Script Property SPREADSHEET_ID terlebih dahulu.');if(!SP.getProperty('SERVER_TOKEN'))throw new Error('Isi Script Property SERVER_TOKEN terlebih dahulu.');const ss=SpreadsheetApp.openById(id);Object.keys(SHEETS).forEach(k=>{let sh=ss.getSheetByName(k)||ss.insertSheet(k);if(sh.getLastRow()===0){sh.appendRow(SHEETS[k]);sh.setFrozenRows(1);sh.getRange(1,1,1,SHEETS[k].length).setFontWeight('bold').setBackground('#075b36').setFontColor('#ffffff');}});const sh=ss.getSheetByName('users');if(sh.getLastRow()===1){const salt=Utilities.getUuid();sh.appendRow(['admin','Administrator Kabupaten','admin','',salt,hash('GantiAdmin123!',salt),true,new Date().toISOString()]);}return 'Setup selesai. Login awal admin / GantiAdmin123!';}
function db(){return SpreadsheetApp.openById(SP.getProperty('SPREADSHEET_ID'));}
function rows(table){if(!SHEETS[table])throw new Error('Tabel tidak valid');const sh=db().getSheetByName(table);if(!sh||sh.getLastRow()<2)return [];const vals=sh.getRange(1,1,sh.getLastRow(),SHEETS[table].length).getValues();return vals.slice(1).filter(r=>r[0]!==''&&r[0]!==null).map(r=>{let o={};SHEETS[table].forEach((k,i)=>o[k]=r[i]);return o;});}
function writeRows(table,data){const sh=db().getSheetByName(table);sh.clearContents();sh.getRange(1,1,1,SHEETS[table].length).setValues([SHEETS[table]]).setFontWeight('bold').setBackground('#075b36').setFontColor('#ffffff');if(data.length)sh.getRange(2,1,data.length,SHEETS[table].length).setValues(data.map(o=>SHEETS[table].map(k=>o[k]===undefined?'':o[k])));sh.setFrozenRows(1);}
function hash(pass,salt){const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,salt+':'+pass);return bytes.map(b=>('0'+((b+256)%256).toString(16)).slice(-2)).join('');}
function login(p){const u=rows('users').find(x=>String(x.username)===String(p.username));if(!u||String(u.active)==='false'||u.active===false||hash(String(p.password||''),u.salt)!==u.passwordHash)throw new Error('Username atau password salah.');const exp=Date.now()+8*60*60*1000,payload=Utilities.base64EncodeWebSafe(JSON.stringify({username:u.username,exp:exp}));const sig=Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(payload,SP.getProperty('SERVER_TOKEN')));return {token:payload+'.'+sig,user:publicUser(u)};}
function verifySession(t){if(!t)throw new Error('Sesi berakhir. Silakan masuk kembali.');const z=String(t).split('.');if(z.length!==2)throw new Error('Sesi tidak valid.');const sig=Utilities.base64EncodeWebSafe(Utilities.computeHmacSha256Signature(z[0],SP.getProperty('SERVER_TOKEN')));if(sig!==z[1])throw new Error('Sesi tidak valid.');const p=JSON.parse(Utilities.newBlob(Utilities.base64DecodeWebSafe(z[0])).getDataAsString());if(p.exp<Date.now())throw new Error('Sesi berakhir.');const u=rows('users').find(x=>x.username===p.username);if(!u||String(u.active)==='false'||u.active===false)throw new Error('Akun tidak aktif.');return u;}
function publicUser(u){return {username:u.username,name:u.name,role:u.role,kua:u.kua||''};}
function getAll(u){let data={};['catin','penerimaan','realisasi','monitoring'].forEach(t=>data[t]=rows(t));data.users=u.role==='admin'?rows('users').map(x=>({username:x.username,name:x.name,role:x.role,kua:x.kua,active:String(x.active)!=='false'})):[];return {data:data};}
function assertScope(u,kua){if(u.role!=='admin'&&String(u.kua)!==String(kua))throw new Error('Anda tidak memiliki akses ke data KUA tersebut.');}
function saveRecord(u,t,d){if(!['catin','penerimaan','realisasi','monitoring'].includes(t))throw new Error('Tabel tidak diizinkan.');const lock=LockService.getScriptLock();lock.waitLock(15000);try{let all=rows(t),old=d.id?all.find(x=>x.id===d.id):null;if(old)assertScope(u,old.kua);if(t==='catin'){d.kua=d.kua||u.kua;assertScope(u,d.kua);d.id=d.id||nextId('CAP-SLM-',all);d.jumlahRencana=Number(d.jumlahRencana)||0;}
if(t==='penerimaan'){const c=rows('catin').find(x=>x.id===d.catinId);if(!c)throw new Error('ID CAPING tidak ditemukan.');assertScope(u,c.kua);Object.assign(d,{kua:c.kua,kapanewon:c.kapanewon,namaCatin1:c.namaCatin1,namaCatin2:c.namaCatin2,jenisKontribusi:c.jenisKontribusi,satuan:d.satuan||c.satuan});d.id=d.id||nextId('P-',all);d.jumlahDiterima=Number(d.jumlahDiterima)||0;}
if(t==='realisasi'){const p=rows('penerimaan').find(x=>x.id===d.penerimaanId);if(!p)throw new Error('ID Penerimaan tidak ditemukan.');assertScope(u,p.kua);Object.assign(d,{catinId:p.catinId,kua:p.kua,kapanewon:p.kapanewon,namaCatin1:p.namaCatin1,namaCatin2:p.namaCatin2,jenisKontribusi:p.jenisKontribusi,jenisSpesies:p.jenisSpesies,jumlahDiterima:Number(p.jumlahDiterima)||0,satuan:p.satuan});d.id=d.id||nextId('R-',all);d.jumlahRealisasi=Number(d.jumlahRealisasi)||0;let previous=all.filter(x=>x.penerimaanId===d.penerimaanId&&x.id!==d.id).reduce((s,x)=>s+(Number(x.jumlahRealisasi)||0),0);d.realisasiSebelumnya=previous;d.saldo=Number(p.jumlahDiterima)-previous-d.jumlahRealisasi;if(d.jumlahRealisasi<=0||d.saldo<0)throw new Error('Jumlah realisasi harus lebih dari 0 dan tidak boleh melebihi saldo penerimaan.');}
if(t==='monitoring'){const r=rows('realisasi').find(x=>x.id===d.realisasiId);if(!r)throw new Error('ID Realisasi tidak ditemukan.');assertScope(u,r.kua);Object.assign(d,{penerimaanId:r.penerimaanId,catinId:r.catinId,kua:r.kua,kapanewon:r.kapanewon,namaCatin1:r.namaCatin1,namaCatin2:r.namaCatin2,jenisKontribusi:r.jenisKontribusi,jenisSpesies:r.jenisSpesies,lokasi:r.lokasi,jumlahRealisasi:r.jumlahRealisasi});d.id=d.id||nextId('M-',all);d.jumlahHidup=Number(d.jumlahHidup)||0;d.jumlahMati=Number(d.jumlahMati)||0;if(d.jumlahHidup+d.jumlahMati>Number(r.jumlahRealisasi))throw new Error('Jumlah hidup/teramati + mati/hilang tidak boleh melebihi jumlah realisasi.');d.persen=Number(r.jumlahRealisasi)?d.jumlahHidup/Number(r.jumlahRealisasi)*100:0;}
d.createdAt=old?old.createdAt:new Date().toISOString();if(old)all=all.map(x=>x.id===d.id?d:x);else all.push(d);writeRows(t,all);return {id:d.id};}finally{lock.releaseLock();}}
function nextId(prefix,all){let max=all.reduce((m,x)=>{let n=Number(String(x.id).replace(prefix,''));return Number.isFinite(n)?Math.max(m,n):m;},0);return prefix+String(max+1).padStart(4,'0');}
function deleteRecord(u,t,id){if(!['catin','penerimaan','realisasi','monitoring'].includes(t))throw new Error('Tabel tidak valid.');const lock=LockService.getScriptLock();lock.waitLock(15000);try{let all=rows(t),x=all.find(v=>v.id===id);if(!x)throw new Error('Data tidak ditemukan.');assertScope(u,x.kua);if(t==='catin'&&rows('penerimaan').some(v=>v.catinId===id))throw new Error('Catin masih memiliki transaksi penerimaan. Hapus transaksi terkait terlebih dahulu.');if(t==='penerimaan'&&rows('realisasi').some(v=>v.penerimaanId===id))throw new Error('Penerimaan masih memiliki realisasi.');if(t==='realisasi'&&rows('monitoring').some(v=>v.realisasiId===id))throw new Error('Realisasi masih memiliki monitoring.');writeRows(t,all.filter(v=>v.id!==id));return {deleted:true};}finally{lock.releaseLock();}}
function saveUser(u,d){if(u.role!=='admin')throw new Error('Hanya admin Kabupaten yang dapat mengelola pengguna.');const lock=LockService.getScriptLock();lock.waitLock(15000);try{let all=rows('users'),old=all.find(x=>x.username===d.username);if(!old&&!d.password)throw new Error('Password wajib diisi.');let x=old||{username:d.username,createdAt:new Date().toISOString()};x.name=d.name;x.role=d.role;x.kua=d.role==='admin'?'':d.kua;x.active=d.active==='true'||d.active===true;if(d.password){if(String(d.password).length<10)throw new Error('Password minimal 10 karakter.');x.salt=Utilities.getUuid();x.passwordHash=hash(d.password,x.salt);}if(old)all=all.map(v=>v.username===x.username?x:v);else all.push(x);writeRows('users',all);return {saved:true};}finally{lock.releaseLock();}}
